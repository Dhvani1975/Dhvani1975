
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Tailwind Navigation Bar</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">

    <!-- Header -->
    <header class="bg-blue-600 text-white shadow-lg">

        <nav class="container mx-auto px-6 py-4
                    flex justify-between items-center flex-wrap">

            <!-- Website Logo -->
            <h1 class="text-2xl font-bold">
                Fresh Cart
            </h1>

            <!-- Mobile Menu Button -->
            <button id="menuBtn"
                    aria-label="Toggle menu"
                    aria-expanded="false"
                    class="md:hidden text-2xl">
                &#9776;
            </button>

            <!-- Navigation Links -->
            <ul id="menu"
                class="hidden md:flex w-full md:w-auto
                       flex-col md:flex-row
                       md:items-center gap-6 mt-4 md:mt-0">

                <li>
                    <a href="#home" class="hover:text-yellow-300">
                        Home
                    </a>
                </li>

                <li>
                    <a href="#about" class="hover:text-yellow-300">
                        About Us
                    </a>
                </li>

                <!-- Dropdown Menu -->
                <li class="relative group">

                    <button type="button"
                            id="dropdownBtn"
                            aria-expanded="false"
                            class="hover:text-yellow-300
                                   flex items-center gap-2">
                        Products
                        <span>&#9662;</span>
                    </button>

                    <!-- Dropdown Items -->
                    <ul id="dropdown"
                        class="hidden md:group-hover:block
                               md:group-focus-within:block
                               md:absolute md:top-full md:left-0
                               bg-white text-gray-800
                               rounded-lg shadow-lg
                               w-44 py-2 z-50">

                        <li>
                            <a href="#fruits"
                               class="block px-4 py-2 hover:bg-blue-100">
                                Fruits
                            </a>
                        </li>

                        <li>
                            <a href="#vegetables"
                               class="block px-4 py-2 hover:bg-blue-100">
                                Vegetables
                            </a>
                        </li>

                        <li>
                            <a href="#dairy"
                               class="block px-4 py-2 hover:bg-blue-100">
                                Dairy Products
                            </a>
                        </li>

                        <li>
                            <a href="#grocery"
                               class="block px-4 py-2 hover:bg-blue-100">
                                Grocery
                            </a>
                        </li>

                    </ul>
                </li>

                <li>
                    <a href="#contact" class="hover:text-yellow-300">
                        Contact Us
                    </a>
                </li>

                <li>
                    <a href="#login"
                       class="bg-white text-blue-600
                              px-4 py-2 rounded-lg
                              hover:bg-yellow-300">
                        Login
                    </a>
                </li>

            </ul>
        </nav>
    </header>

    <!-- Home Section -->
    <section id="home" class="text-center py-20 px-4">

        <h2 class="text-4xl font-bold text-blue-600 mb-4">
            Welcome to Fresh Cart
        </h2>

        <p class="text-gray-600 text-lg">
            Fresh groceries delivered to your doorstep.
        </p>

        <button class="mt-6 bg-blue-600 text-white
                       px-6 py-3 rounded-lg
                       hover:bg-blue-700">
            Shop Now
        </button>

    </section>

    <!-- JavaScript for Mobile Navigation -->
    <script>
        const menuBtn = document.getElementById("menuBtn");
        const menu = document.getElementById("menu");
        const dropdownBtn = document.getElementById("dropdownBtn");
        const dropdown = document.getElementById("dropdown");

        // Toggle mobile menu
        menuBtn.addEventListener("click", () => {
            menu.classList.toggle("hidden");

            menuBtn.setAttribute(
                "aria-expanded",
                !menu.classList.contains("hidden")
            );
        });

        // Toggle dropdown on click
        dropdownBtn.addEventListener("click", () => {
            dropdown.classList.toggle("hidden");

            dropdownBtn.setAttribute(
                "aria-expanded",
                !dropdown.classList.contains("hidden")
            );
        });
    </script>

</body>
</html>

<!DOCTYPE html> 
<html> 
<head> 
    <title>Flexbox Child Properties</title> 
 
    <style>         .container {             display: flex; 
    
            height: 400px;             border: 3px solid rgb(12, 11, 11);             align-items: center; 
            background-color: beige; 
        } 
        .box {             width: 100px;             height: 100px;             margin: 10px;             background-color: rgb(159, 202, 242);             border: 2px solid rgb(3, 72, 150); 
            text-align: center;             line-height: 100px;            font-weight: bold; 
        } 
        .box1 { 
        
            flex-grow: 1;             flex-basis: 200px ; 
            flex-shrink: 10;          
        } 
         .box2 {             flex-grow:1; 
            align-self:self-end; 
        } 
 
        .box3 {            flex-grow: 3; 
           align-self:baseline; 
        } 
 
         .box4 {             flex-grow: 10; 
            align-self:stretch; 
        } 
        .box5 { 
        
            flex-grow: 6; 
            align-self:center 
        } 
         .box6{             flex-shrink: 10; 
            align-self:normal; 
        } 
 
         
         
    </style> 
</head> 
 
<body> 
 
    <h2 style="text-align:center;">Flexbox Child Properties</h2>    <div class="container"> 
 
        <div class="box box1">Box 1</div> 
        <div class="box box2">Box 2</div> 
        <div class="box box3">Box 3</div> 
        <div class="box box4">Box 4</div> 
        <div class="box box5">Box 5</div> 
        <div class="box box6">Box 6</div> 
 
    </div> 
 
</body> 
</html> 

 
 
 
 
 
 
 
 

